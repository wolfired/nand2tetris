/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    // Compute out + 1
    Inc16(in=outReg, out=incOut);
    
    // Choose next value based on control signals
    // Priority: reset > load > inc > hold
    Mux16(a=outReg, b=incOut, sel=inc, out=incOrHold);
    Mux16(a=incOrHold, b=in, sel=load, out=loadOrIncOrHold);
    Mux16(a=loadOrIncOrHold, b=false, sel=reset, out=nextValue);
    
    // Register the value
    Register(in=nextValue, load=true, out=out, out=outReg);
}
